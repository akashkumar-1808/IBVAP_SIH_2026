# ==============================================================================
# IBVAP — PRODUCTION & LOCAL DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` or set these in Render Dashboard / Hosting Provider.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# 1. Environment & Service Settings
ENVIRONMENT=production
APP_NAME=IBVAP-Backend
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# 2. Storage Paths (Platform-Safe Path Handling)
# In production on Render with a persistent disk, mount at /opt/render/project/src/storage
STORAGE_ROOT=storage
DEMO_VIDEO_PATH=storage/samples/test_video.mp4

# 3. Camera & AI Perception Configuration
DEFAULT_CAMERA_ID=DEMO-CAM-01
DEFAULT_DEVICE=cpu
YOLO_MODEL_PATH=models/detector/yolov8n.pt
AUTO_START_DEMO_PIPELINE=true

# 4. Optional Remote Supabase PostgreSQL & Evidence Storage
# (If unconfigured or unreachable, system seamlessly uses fast in-memory fallback)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
EVIDENCE_STORAGE_BUCKET=evidence
MAX_UPLOAD_SIZE_MB=50
