# ==========================================
# IBVAP Backend Environment Configuration Template
# Copy this file to `backend/.env` or `.env` for local development.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==========================================

# Application Settings
ENVIRONMENT=development
APP_NAME=IBVAP-Backend
DEBUG=false
LOG_LEVEL=INFO
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Supabase Project Configuration (Provided by Administrator)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Direct/Pooled PostgreSQL Database Connection String (Optional for direct ORM access)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage Configuration for Evidence Snapshots & Video Clips
EVIDENCE_STORAGE_BUCKET=evidence
MAX_UPLOAD_SIZE_MB=50
